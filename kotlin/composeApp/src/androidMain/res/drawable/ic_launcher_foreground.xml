<?xml version="1.0" encoding="utf-8"?>
<!-- A key, drawn as a vector so there are no raster assets to keep in sync
     across densities. Adaptive icons are native from API 26, which is our
     minSdk, so no legacy PNG fallbacks are needed. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Bow: outer circle with an inner circle punched out via evenOdd. -->
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M38,40 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0 z
                          M47,40 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0 z" />

    <!-- Stem and teeth. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,54 h8 v32 h-8 z
                          M58,68 h11 v7 h-11 z
                          M58,79 h8 v6 h-8 z" />
</vector>
